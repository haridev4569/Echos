# Environment Configuration Template
# Copy this file to backend/.env and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================

# Port number for the server to listen on
# Default: 5001
PORT=5001

# Application environment
# Options: development, production, test
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB Connection URI
# For local MongoDB: mongodb://localhost:27017/echos
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/echos?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================

# Secret key for JWT token generation and verification
# IMPORTANT: Use a long, random, secure string (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================

# Cloudinary Cloud Name
# Find in: Cloudinary Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary API Key
# Find in: Cloudinary Dashboard > Account Details
CLOUDINARY_API_KEY=your_api_key

# Cloudinary API Secret
# Find in: Cloudinary Dashboard > Account Details
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# CORS Origin (for development)
# Default: http://localhost:5173
# CORS_ORIGIN=http://localhost:5173

# Session Secret (if using express-session)
# SESSION_SECRET=your_session_secret

# Rate Limiting (requests per window)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Log Level
# Options: error, warn, info, http, verbose, debug, silly
# LOG_LEVEL=info

# ============================================
# NOTES
# ============================================

# 1. Never commit this file with actual values to version control
# 2. Keep your secrets secure and rotate them regularly
# 3. Use different values for development, staging, and production
# 4. For production, set NODE_ENV=production
# 5. Ensure JWT_SECRET is at least 32 characters long
# 6. For MongoDB Atlas, whitelist your IP address in Network Access
# 7. Create a dedicated database user with appropriate permissions
